  MARKET
  EXHIBITION
  AUCTION
}
enum ListingStatus {
  DRAFT
  ACTIVE
  SOLD
  UNPUBLISHED
  EXPIRED
}
enum AuthorizationType {
  SELL_ONLY
  SELL_AND_RECEIVE
}
enum AuthorizationStatus {
  PENDING
  ACTIVE
  REJECTED
  REVOKED
  EXPIRED
}
enum LedgerEntryType {
  CUSTOMER_FUNDS
  ESCROW_FUNDS
  PLATFORM_FEES
  SELLER_PAYOUTS
  REFUNDS
  GOVERNMENT_FEES
  AUCTION_FEES
  TRANSFER_FEES
  LISTING_SALES_COMMISSION
}
enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
}
enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}
enum OperationStatus {
  PENDING
  SUCCESS
