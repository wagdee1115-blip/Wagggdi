  ownerConsentAt DateTime?
  ownerOtpVerifiedAt DateTime?
  authorizedOtpVerifiedAt DateTime?
  revokedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([vehicleId, status])
  @@index([authorizedUserId, status])
}

