# Required in production
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/markabat?schema=public"
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-chars"

# Runtime configuration read by the application
# Explicitly enables the visible government-demo banner. It never enables real providers or bypasses their checks.
APP_MODE=""
# Canonical public origin (for example https://markabat.example); required in production.
APP_BASE_URL=""
EXCHANGE_RATE_DEFAULT="535"
PAYOUT_PROTECTION_MINUTES="15"
SELLER_CONFIRMATION_EXPIRY_MINUTES="10"
OTP_EXPIRY_MINUTES="5"
OTP_MAX_ATTEMPTS="5"
# Recommended dedicated 32+ character pepper for keyed OTP digests.
# JWT_SECRET is used only as a deployment-safe fallback when this is empty.
OTP_HASH_SECRET=""
NODE_ENV="development"

# Local/test seed only. Never run the seed in production. Both values are required explicitly.
ALLOW_DEMO_SEED=""
SEED_ADMIN_PASSWORD=""

# External providers: leave empty until a real provider is configured. Never replace with mock success.
IDENTITY_PROVIDER_URL=""
IDENTITY_PROVIDER_SECRET=""
SMS_PROVIDER_URL=""
SMS_PROVIDER_SECRET=""
PAYMENT_PROVIDER_URL=""
PAYMENT_PROVIDER_API_SECRET=""
PAYMENT_PROVIDER_WEBHOOK_SECRET=""
PAYOUT_PROVIDER_URL=""
PAYOUT_PROVIDER_SECRET=""
# Required before storing payout accounts: 32 random bytes as base64 or 64 hexadecimal characters.
PAYOUT_DATA_ENCRYPTION_KEY=""
ESCROW_PROVIDER_URL=""
ESCROW_PROVIDER_SECRET=""
TRAFFIC_PROVIDER_URL=""
TRAFFIC_PROVIDER_SECRET=""
TRAFFIC_PROVIDER_WEBHOOK_SECRET=""
AUCTION_DEPOSIT_PROVIDER_URL=""
AUCTION_DEPOSIT_PROVIDER_SECRET=""
AUTHORIZATION_DOCUMENT_STORAGE_URL=""
AUTHORIZATION_DOCUMENT_STORAGE_SECRET=""
SUPPORT_STORAGE_URL=""
SUPPORT_STORAGE_SECRET=""
CRON_SECRET=""
STORAGE_PROVIDER_URL=""
STORAGE_PROVIDER_TOKEN=""
MALWARE_SCANNER_URL=""
MALWARE_SCANNER_SECRET=""
PLATE_REDACTION_PROVIDER_URL=""
PLATE_REDACTION_PROVIDER_SECRET=""
AI_DESCRIPTION_PROVIDER_URL=""
AI_DESCRIPTION_PROVIDER_SECRET=""
BANK_PROVIDER_URL=""
BANK_PROVIDER_SECRET=""
BANK_TRANSFER_ACCOUNT_ID=""
