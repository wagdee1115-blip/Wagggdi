{
  "name": "markabat",
  "version": "1.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/verify-css-output.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "test": "vitest run",
    "postinstall": "prisma generate",
    "ci:verify": "prisma generate && prisma migrate deploy && npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "@types/react-dom": "19.2.4",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "jose": "^5.6.0",
    "lucide-react": "^0.400.0",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^2.3.0",
    "zod": "^3.23.8",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.12.12",
    "@types/react": "19.2.18",
    "autoprefixer": "^10.4.19",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.1",
    "postcss": "^8.4.38",
    "prisma": "5.22.0",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.15.6",
    "typescript": "^5.5.3",
    "vitest": "^1.6.0"
  },
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": "22.x"
  }
}
