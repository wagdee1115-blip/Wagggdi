{
  "name": "markabat",
  "version": "1.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "test": "vitest run",
    "postinstall": "prisma generate",
    "ci:verify": "prisma generate && prisma migrate deploy && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "next": "^14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@prisma/client": "5.22.0",
    "bcryptjs": "^2.4.3",
    "jose": "^5.6.0",
    "zod": "^3.23.8",
    "zustand": "^4.5.2",
    "lucide-react": "^0.400.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.3.0"
  },
  "devDependencies": {
    "typescript": "^5.5.3",
    "@types/node": "^20.12.12",
    "@types/react": "^18.3.3",
    "@types/bcryptjs": "^2.4.6",
    "prisma": "5.22.0",
    "tailwindcss": "^3.4.4",
    "postcss": "^8.4.38",
    "autoprefixer": "^10.4.19",
    "tsx": "^4.15.6",
    "vitest": "^1.6.0"
  },
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=20.0.0"
  }
}
